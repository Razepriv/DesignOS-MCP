{
  "manifest_version": 3,
  "name": "DesignOS Clipper",
  "version": "0.1.0",
  "description": "Capture pages, elements, and design systems for DesignOS",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" } },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "background": { "service_worker": "background.js" }
}
