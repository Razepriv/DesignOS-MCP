# DesignOS Configuration
# Copy to .env and fill in required values

# ── Core ──
DESIGNOS_HOME=.designos
DESIGNOS_DB_PATH=.designos/designos.db

# ── Token Governor ──
DESIGNOS_MAX_CONTEXT_TOKENS=12000
DESIGNOS_MAX_SOURCES=12
DESIGNOS_SEMANTIC_CACHE_THRESHOLD=0.92

# ── External Services (optional for local dev) ──
TINYFISH_API_KEY=
CAVEMAN_MCP_BIN=
VERCEL_TOKEN=

# ── Embedding Provider ──
# Options: local (default, no API key needed), openai
DESIGNOS_EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# ── Licensed Source Credentials (optional) ──
# Set these for authenticated sources
MOBBIN_API_KEY=
RELUME_API_KEY=
